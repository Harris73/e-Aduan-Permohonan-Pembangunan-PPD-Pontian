# Copy to .env for local `netlify dev`. Never commit the real .env.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
# true = anyone with the link can open archived files (unguessable URL); false = only Google accounts you share the folder with
DRIVE_PUBLIC_LINKS=false
